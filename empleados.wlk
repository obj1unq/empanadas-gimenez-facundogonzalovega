//Escribir aqui los objetos
object galvan {
  var sueldo = 15000

  method sueldo() {
    return sueldo
  }

  method sueldo(_sueldo) {
    sueldo = _sueldo
  }
}

object baigorria {
  var sueldo = 0
  var vender = 0

  method sueldo() {
    return sueldo
  }

  method sueldo(_sueldo) {
    sueldo = _sueldo
  }

  method vender() {
    return vender
  }
  
  method vender(_vender) {
    vender = _vender
  }

}

